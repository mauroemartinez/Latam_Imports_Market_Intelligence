/// Carpeta data del repositorio, con la barra final. Cambiala si clonás el repo en otra ruta.
expression CarpetaDatos = "C:\Proyectos\Latam_Imports_Market_Intelligence\data\" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	lineageTag: f3bb0020-e88b-5bbb-9181-1c1cd2dd96d6
