{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.1.0/schema.json",
  "name": "tt-origine",
  "displayName": "Tooltip - Origine",
  "displayOption": "FitToPage",
  "height": 160,
  "width": 320,
  "type": "Tooltip",
  "visibility": "HiddenInViewMode",
  "pageBinding": {
    "name": "ttOrigineBinding",
    "type": "Tooltip",
    "parameters": []
  },
  "objects": {
    "background": [
      {
        "properties": {
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          },
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#040F23'"
                  }
                }
              }
            }
          },
          "image": {
            "image": {
              "name": {
                "expr": {
                  "Literal": {
                    "Value": "'page-tooltip.png'"
                  }
                }
              },
              "url": {
                "expr": {
                  "ResourcePackageItem": {
                    "PackageName": "RegisteredResources",
                    "PackageType": 1,
                    "ItemName": "page-tooltip.png"
                  }
                }
              },
              "scaling": {
                "expr": {
                  "Literal": {
                    "Value": "'Fit'"
                  }
                }
              }
            }
          }
        }
      }
    ],
    "outspace": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#040F23'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ]
  }
}